# PLACEHOLDERS ONLY. No default real call, wallet, or guard path is enabled.
SPENDPASS_WALLETS_FILE=/CHOOSE_PRIVATE_STORAGE/testnet-wallets.json
SPENDPASS_QUOTA_ENV_FILE=/CHOOSE_PRIVATE_STORAGE/existing-quota.env
SPENDPASS_QUOTA_KEY_NAME=SPENDPASS_API_KEY
SPENDPASS_PROVIDER_URL=https://YOUR_AUTHORIZED_PROVIDER/v1/chat/completions
# Set this to the EXISTING permanent attempt guard. Do not delete/rename/replace.
SPENDPASS_ATTEMPT_GUARD=/CHOOSE_PRIVATE_STORAGE/actual-provider-attempt.json
SPENDPASS_CONTEXT_FILE=evidence/CHOOSE_SAVED_CONTEXT.json
SPENDPASS_RUNTIME_BASE_DIRECTORY=.runtime/CHOOSE_EXISTING_WORKFLOW
SPENDPASS_RUNTIME_DIRECTORY=.runtime/CHOOSE_EXISTING_WORKFLOW/operatorA
SPENDPASS_WORKER_ROLE=operatorA
# Optional deterministic fixture A: reads no quota key; performs no provider HTTP.
# SPENDPASS_FIXTURE_A=1

# Separately approved restricted key for a NEW task only; old Failed task is immutable.
SPENDPASS_APPROVED_QUOTA_ENV_FILE=/CHOOSE_PRIVATE_STORAGE/approved-restricted-key.env
SPENDPASS_APPROVED_ATTEMPT_GUARD=/CHOOSE_PRIVATE_STORAGE/approved-new-task-attempt.json

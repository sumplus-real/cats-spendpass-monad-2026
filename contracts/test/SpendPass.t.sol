pragma solidity ^0.8.28;
import "../src/SpendPass.sol";
interface Vm { function addr(uint256) external returns(address); function sign(uint256,bytes32) external returns(uint8,bytes32,bytes32); function deal(address,uint256) external; function prank(address) external; function expectRevert() external; function warp(uint256) external; function chainId(uint256) external; function store(address,bytes32,bytes32) external; function envOr(string calldata,bool) external returns(bool); }
contract Reject { receive() external payable { revert("reject"); } }
contract Reenter { SpendPass public c; bytes32 public id; bool public attacked; bool public innerSucceeded; function configure(SpendPass x,bytes32 y) external {c=x;id=y;} receive() external payable {attacked=true;(innerSucceeded,)=address(c).call(abi.encodeCall(c.claim,(id)));} }
contract Force { constructor() payable {} function send(address payable x) external {selfdestruct(x);} }
contract RejectOwner { SpendPass c; constructor(SpendPass x) {c=x;} function create(SpendPass.Policy memory p) external payable returns(bytes32){p.owner=address(this);return c.createRoot{value:msg.value}(p);} function close(bytes32 id) external {c.close(id);} function withdraw(bytes32 id) external {c.withdraw(id);} receive() external payable {revert("reject owner");} }
contract WithdrawReenter { SpendPass c; bytes32 id; bool public attacked; bool public innerSucceeded; constructor(SpendPass x) {c=x;} function create(SpendPass.Policy memory p) external payable returns(bytes32){p.owner=address(this);id=c.createRoot{value:msg.value}(p);return id;} function recover() external {c.close(id);c.withdraw(id);} receive() external payable {attacked=true;(innerSucceeded,)=address(c).call(abi.encodeCall(c.withdraw,(id)));} }
contract SpendPassTest {
    Vm constant vm=Vm(address(uint160(uint256(keccak256("hevm cheat code")))));
    SpendPass c; address a; address b; address payA; address payB; bytes32 root;
    receive() external payable {}
    function setUp() public {vm.chainId(10143);c=new SpendPass();a=vm.addr(11);b=vm.addr(22);payA=vm.addr(33);payB=vm.addr(44);vm.deal(address(this),2 ether);root=c.createRoot{value:.01 ether}(policy());}
    function policy() internal view returns(SpendPass.Policy memory){return SpendPass.Policy(address(this),a,a,payA,b,payB,.01 ether,.002 ether,.004 ether,.008 ether,block.timestamp+1000);}
    function quote(bytes32 id,uint256 fee,uint256 key) internal view returns(SpendPass.Quote memory){return SpendPass.Quote(id,key==11?a:b,key==11?payA:payB,keccak256("task"),keccak256("model"),fee,block.timestamp+500,1,c.policyHash(root));}
    function signature(SpendPass.Quote memory q,uint256 key) internal returns(bytes memory){(uint8 v,bytes32 r,bytes32 s)=vm.sign(key,c.quoteDigest(q));return abi.encodePacked(r,s,v);}
    function reserve(bytes32 id,uint256 fee,uint256 key) internal {SpendPass.Quote memory q=quote(id,fee,key);bytes memory sig=signature(q,key);vm.prank(a);c.reserve(q,sig);}
    function acceptRoot() internal {reserve(root,.002 ether,11);vm.prank(a);c.accept(root);}
    function splitRoot() internal {acceptRoot();uint256[] memory xs=new uint256[](2);xs[0]=.004 ether;xs[1]=.004 ether;vm.prank(a);c.split(root,xs);}
    function eq(uint256 x,uint256 y) internal pure {require(x==y,"assert eq");}
    function g(bytes32 id) internal view returns(SpendPass.Grant memory x) {(x.rootId,x.originalAllocation,x.free,x.held,x.providerUnclaimed,x.providerClaimed,x.ownerWithdrawn,x.delegatedOutstanding,x.depth)=c.grants(id);}
    function state(bytes32 id) internal view returns(SpendPass.OfferState s){(s,,,,,)=c.offers(id);}
    function conservation() internal view {require(c.ledgerValid(root),"root ledger");uint256 sum=g(root).free+g(root).held+g(root).providerUnclaimed;for(uint256 i;i<c.childCount(root);i++){bytes32 id=c.childId(root,i);require(c.ledgerValid(id),"child ledger");sum+=g(id).free+g(id).held+g(id).providerUnclaimed;}eq(sum,c.accountedBalance());eq(sum,address(c).balance);}
    function testFullColdRecovery() public {splitRoot();bytes32 c0=c.childId(root,0);bytes32 c1=c.childId(root,1);reserve(c0,.004 ether,22);reserve(c1,.004 ether,22);vm.prank(b);c.accept(c0);conservation();eq(g(root).providerUnclaimed+g(c0).providerUnclaimed,.006 ether);c.close(root);c.release(c1);uint256 before=address(this).balance;c.withdraw(c1);eq(address(this).balance-before,.004 ether);c.claim(root);c.claim(c0);eq(payA.balance,.002 ether);eq(payB.balance,.004 ether);eq(c.paidOut(),.01 ether);conservation();}
    function testBothChildrenAcceptedOwnerRefundZero() public {splitRoot();for(uint256 i;i<2;i++){bytes32 id=c.childId(root,i);reserve(id,.004 ether,22);vm.prank(b);c.accept(id);}c.close(root);for(uint256 i;i<2;i++){bytes32 id=c.childId(root,i);vm.expectRevert();c.withdraw(id);vm.expectRevert();c.cancel(id);c.claim(id);}c.claim(root);eq(payB.balance,.008 ether);conservation();}
    function testCancelWinsPermanentSlot() public {reserve(root,.002 ether,11);c.cancel(root);vm.prank(a);vm.expectRevert();c.accept(root);SpendPass.Quote memory q=quote(root,.002 ether,11);q.taskInputHash=keccak256("changed");q.nonce=99;bytes memory sig=signature(q,11);vm.prank(a);vm.expectRevert();c.reserve(q,sig);conservation();}
    function testAcceptWinsNoRefund() public {acceptRoot();vm.expectRevert();c.cancel(root);c.close(root);vm.expectRevert();c.release(root);c.withdraw(root);eq(g(root).providerUnclaimed,.002 ether);c.claim(root);conservation();}
    function testCloseWinsAcceptAndSplit() public {reserve(root,.002 ether,11);c.close(root);vm.prank(a);vm.expectRevert();c.accept(root);c.release(root);c.withdraw(root);conservation();}
    function testAcceptThenCloseBlocksSplit() public {acceptRoot();c.close(root);uint256[] memory xs=new uint256[](1);xs[0]=.004 ether;vm.prank(a);vm.expectRevert();c.split(root,xs);conservation();}
    function testRootFeeCap() public {SpendPass.Quote memory q=quote(root,.003 ether,11);bytes memory sig=signature(q,11);vm.prank(a);vm.expectRevert();c.reserve(q,sig);conservation();}
    function testWrongDelegateOperatorPayeeAndPolicy() public {SpendPass.Quote memory q=quote(root,.002 ether,11);bytes memory sig=signature(q,11);vm.prank(b);vm.expectRevert();c.reserve(q,sig);q.payee=payB;sig=signature(q,11);vm.prank(a);vm.expectRevert();c.reserve(q,sig);q=quote(root,.002 ether,11);q.policyHash=bytes32(uint256(7));sig=signature(q,11);vm.prank(a);vm.expectRevert();c.reserve(q,sig);reserve(root,.002 ether,11);vm.prank(b);vm.expectRevert();c.accept(root);conservation();}
    function testSignatureAndPayloadDomainReplay() public {SpendPass.Quote memory q=quote(root,.002 ether,11);bytes memory sig=signature(q,11);q.taskInputHash=keccak256("altered");vm.prank(a);vm.expectRevert();c.reserve(q,sig);q=quote(root,.002 ether,11);vm.chainId(1);vm.prank(a);vm.expectRevert();c.reserve(q,sig);vm.chainId(10143);conservation();}
    function testAllocationCountDepthDuplicateSplit() public {acceptRoot();uint256[] memory xs=new uint256[](3);xs[0]=.001 ether;xs[1]=.001 ether;xs[2]=.001 ether;vm.prank(a);vm.expectRevert();c.split(root,xs);xs=new uint256[](2);xs[0]=.005 ether;xs[1]=.003 ether;vm.prank(a);vm.expectRevert();c.split(root,xs);xs[0]=.004 ether;xs[1]=.004 ether;vm.prank(a);c.split(root,xs);vm.prank(a);vm.expectRevert();c.split(root,xs);bytes32 id=c.childId(root,0);reserve(id,.004 ether,22);vm.prank(b);c.accept(id);vm.prank(a);vm.expectRevert();c.split(id,xs);conservation();}
    function testChildCannotBeAcceptedByDelegate() public {splitRoot();bytes32 id=c.childId(root,0);reserve(id,.004 ether,22);vm.prank(a);vm.expectRevert();c.accept(id);conservation();}
    function testQuoteExpiredReleaseAndRootExpiry() public {reserve(root,.002 ether,11);vm.warp(block.timestamp+500);vm.prank(a);vm.expectRevert();c.accept(root);c.release(root);vm.expectRevert();c.withdraw(root);(,,,,,,,,,,uint256 expiry)=c.policies(root);vm.warp(expiry);c.withdraw(root);conservation();}
    function testReserveBeyondPolicyExpiryRejected() public {SpendPass.Quote memory q=quote(root,.002 ether,11);q.expiry=block.timestamp+1001;bytes memory sig=signature(q,11);vm.prank(a);vm.expectRevert();c.reserve(q,sig);}
    function testActiveWithdrawalAndEarlyReleaseRejected() public {reserve(root,.002 ether,11);vm.expectRevert();c.withdraw(root);vm.prank(b);vm.expectRevert();c.release(root);vm.prank(b);vm.expectRevert();c.close(root);}
    function testDoubleClaimDoubleWithdraw() public {acceptRoot();c.claim(root);vm.expectRevert();c.claim(root);c.close(root);c.withdraw(root);vm.expectRevert();c.withdraw(root);conservation();}
    function testRejectPayeeRollsBack() public {Reject r=new Reject();SpendPass.Policy memory p=policy();p.rootPayee=address(r);bytes32 id=c.createRoot{value:.01 ether}(p);SpendPass.Quote memory q=quote(id,.002 ether,11);q.payee=address(r);q.policyHash=c.policyHash(id);bytes memory sig=signature(q,11);vm.prank(a);c.reserve(q,sig);vm.prank(a);c.accept(id);vm.expectRevert();c.claim(id);eq(g(id).providerUnclaimed,.002 ether);eq(g(id).providerClaimed,0);eq(c.paidOut(),0);require(c.ledgerValid(id),"rollback ledger");}
    function testRejectOwnerRollsBack() public {RejectOwner o=new RejectOwner(c);bytes32 id=o.create{value:.01 ether}(policy());o.close(id);vm.expectRevert();o.withdraw(id);eq(g(id).free,.01 ether);eq(g(id).ownerWithdrawn,0);eq(c.paidOut(),0);}
    function testReentrantClaimBlocked() public {Reenter r=new Reenter();SpendPass.Policy memory p=policy();p.rootPayee=address(r);bytes32 id=c.createRoot{value:.01 ether}(p);r.configure(c,id);SpendPass.Quote memory q=quote(id,.002 ether,11);q.payee=address(r);q.policyHash=c.policyHash(id);bytes memory sig=signature(q,11);vm.prank(a);c.reserve(q,sig);vm.prank(a);c.accept(id);c.claim(id);require(r.attacked() && !r.innerSucceeded(),"reentrancy guard");eq(address(r).balance,.002 ether);eq(g(id).providerClaimed,.002 ether);}
    function testForcedSurplusSeparate() public {Force f=new Force{value:.001 ether}();f.send(payable(address(c)));eq(c.unsolicitedSurplus(),.001 ether);eq(c.accountedBalance(),.01 ether);require(c.ledgerValid(root),"surplus ledger");}
    function testKnownBadDoubleCreditDetector() public {splitRoot();SpendPass.Grant memory x=g(root);x.free+=.004 ether;bool valid=x.originalAllocation==x.free+x.held+x.providerUnclaimed+x.providerClaimed+x.ownerWithdrawn+x.delegatedOutstanding;require(!valid,"knownbad must turn red");uint256 badAssetSum=g(root).free+g(root).held+g(root).providerUnclaimed+g(c.childId(root,0)).free+g(c.childId(root,1)).free+g(root).delegatedOutstanding;require(badAssetSum!=c.accountedBalance(),"parent double count must turn red");}
    function testExactDepositAndImmutableCaps() public {SpendPass.Policy memory p=policy();vm.expectRevert();c.createRoot{value:.009 ether}(p);p.rootFeeMax=.003 ether;vm.expectRevert();c.createRoot{value:.01 ether}(p);p=policy();p.perChildMax=.005 ether;vm.expectRevert();c.createRoot{value:.01 ether}(p);p=policy();p.childrenTotalMax=.009 ether;vm.expectRevert();c.createRoot{value:.01 ether}(p);}
    function testFuzzFullRecovery(uint64 rawA,uint64 rawB) public {splitRoot();bytes32 c0=c.childId(root,0);bytes32 c1=c.childId(root,1);uint256 fa=uint256(rawA)%.004 ether+1;uint256 fb=uint256(rawB)%.004 ether+1;reserve(c0,fa,22);reserve(c1,fb,22);vm.prank(b);c.accept(c0);c.close(root);c.release(c1);c.withdraw(c0);c.withdraw(c1);c.claim(root);c.claim(c0);eq(c.paidOut(),.01 ether);conservation();}
    function testMachineGuardActualStorageDoubleCredit() public {
        splitRoot();
        if(vm.envOr("CATS_KNOWN_BAD",false)) {
            // Actual parent.free mapping storage mutation, not a mirror-only mock.
            bytes32 freeSlot=bytes32(uint256(keccak256(abi.encode(root,uint256(1))))+2);
            vm.store(address(c),freeSlot,bytes32(g(root).free+.004 ether));
        }
        conservation();
    }
    function testChildFeeCap() public {splitRoot();bytes32 id=c.childId(root,0);SpendPass.Quote memory q=quote(id,.005 ether,22);bytes memory sig=signature(q,22);vm.prank(a);vm.expectRevert();c.reserve(q,sig);conservation();}
    function testChildrenTotalPolicyLowerThanHardCap() public {SpendPass.Policy memory p=policy();p.childrenTotalMax=.006 ether;bytes32 id=c.createRoot{value:.01 ether}(p);SpendPass.Quote memory q=quote(id,.002 ether,11);q.policyHash=c.policyHash(id);bytes memory sig=signature(q,11);vm.prank(a);c.reserve(q,sig);vm.prank(a);c.accept(id);uint256[] memory xs=new uint256[](2);xs[0]=.004 ether;xs[1]=.004 ether;vm.prank(a);vm.expectRevert();c.split(id,xs);eq(g(id).free,.008 ether);eq(g(id).delegatedOutstanding,0);require(!c.didSplit(id),"atomic failed split");}

    function testReentrantWithdrawBlocked() public {WithdrawReenter o=new WithdrawReenter(c);bytes32 id=o.create{value:.01 ether}(policy());o.recover();require(o.attacked() && !o.innerSucceeded(),"withdraw reentry");eq(address(o).balance,.01 ether);eq(g(id).ownerWithdrawn,.01 ether);eq(g(id).free,0);require(c.ledgerValid(id),"withdraw ledger");}
    function testClosingBlocksChildReserveAndAccept() public {splitRoot();bytes32 c0=c.childId(root,0);bytes32 c1=c.childId(root,1);reserve(c0,.004 ether,22);SpendPass.Quote memory q=quote(c1,.004 ether,22);bytes memory sig=signature(q,22);c.close(root);vm.prank(a);vm.expectRevert();c.reserve(q,sig);vm.prank(b);vm.expectRevert();c.accept(c0);c.release(c0);c.withdraw(c0);c.withdraw(c1);c.claim(root);conservation();}
    function testWorkflowExpiredStopsChildAdmission() public {splitRoot();bytes32 id=c.childId(root,0);reserve(id,.004 ether,22);(,,,,,,,,,,uint256 expiry)=c.policies(root);vm.warp(expiry);vm.prank(b);vm.expectRevert();c.accept(id);c.release(id);c.withdraw(id);c.withdraw(c.childId(root,1));c.claim(root);conservation();}
    function testRootIdentityAndContractDomain() public {bytes32 next=c.createRoot{value:.01 ether}(policy());require(next!=root,"unique owner nonce");eq(c.creationNonce(address(this)),2);SpendPass other=new SpendPass();SpendPass.Quote memory q=quote(root,.002 ether,11);bytes memory sig=signature(q,11);require(other.quoteDigest(q)!=c.quoteDigest(q),"contract domain");}

    function testPolicyRejectsSharedOperator() public {SpendPass.Policy memory p=policy();p.childOperator=p.rootOperator;vm.expectRevert();c.createRoot{value:.01 ether}(p);eq(c.creationNonce(address(this)),1);eq(c.registeredFunding(),.01 ether);}
    function testPolicyRejectsDelegateDifferentFromA() public {SpendPass.Policy memory p=policy();p.delegate=b;vm.expectRevert();c.createRoot{value:.01 ether}(p);eq(c.creationNonce(address(this)),1);eq(c.registeredFunding(),.01 ether);}

}
